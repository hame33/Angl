# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Supabase project (Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://ckijrhfynlofoeylnsfj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The name shown in the header and link previews.
NEXT_PUBLIC_SITE_NAME=Beyond The Arc

# The site's public address, used for absolute Open Graph URLs. On Vercel this
# falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://example.com

# Substack publication. The subscribe button links to <this>/subscribe.
NEXT_PUBLIC_SUBSTACK_URL=https://hamishdawson33.substack.com

# Umami analytics. Leave the website id empty and no analytics script loads.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
